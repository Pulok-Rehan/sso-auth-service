        <band height="540">
            <!-- Outer frame -->
            <frame>
                <reportElement x="0" y="0" width="782" height="520" backcolor="#f9f9f9" mode="Opaque"/>

                <!-- Section Title -->
                <staticText>
                    <reportElement x="0" y="0" width="782" height="25" backcolor="#e6aa12" mode="Opaque" uuid="3c9a292d-21d7-4748-9405-ff4053e3a576"/>
